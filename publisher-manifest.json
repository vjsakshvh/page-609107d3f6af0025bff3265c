t-weight:400;color:var(--ink-soft);margin-left:4px}\n  .annual{font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:.84rem;color:var(--wine-soft);margin:6px 0 14px}\n  .tag{display:inline-block;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:.72rem;letter-spacing:.14em;padding:3px 9px;background:var(--wine);color:var(--ivory);margin-bottom:10px}\n  .note{font-size:.86rem;color:var(--ink-soft);margin-top:22px;padding-top:14px;border-top:1px dashed var(--line)}\n\n  /* ---- 两步/多列文字块 ---- */\n  .cols{display:grid;gap:26px}\n  @media(min-width:760px){\n    .cols--2{grid-template-columns:1fr 1fr}\n    .cols--3{grid-template-columns:repeat(3,1fr)}\n  }\n  .plain h3{padding-bottom:6px;border-bottom:1px solid rgba(109,31,44,.25);margin-bottom:10px}\n  .band--wine .plain h3,.band--deep .plain h3{border-color:rgba(247,242,232,.3)}\n\n  ol.steps-list{list-style:none;counter-reset:s;margin:0;padding:0}\n  ol.steps-list li{counter-increment:s;position:relative;padding-left:46px;margin-bottom:18px;font-size:.96rem}\n  ol.steps-list li::before{content:counter(s,decimal-leading-zero);position:absolute;left:0;top:-2px;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:.9rem;letter-spacing:.06em;color:var(--wine-soft);border:1px dashed var(--wine-soft);width:32px;height:32px;display:flex;align-items:center;justify-content:center}\n\n  /* ---- FAQ 分组 ---- */\n  .faq-group{margin-bottom:34px}\n  .faq-group:last-child{margin-bottom:0}\n  .faq-group__head{font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:.78rem;letter-spacing:.22em;color:var(--accent);margin:0 0 4px}\n  .band--warm .faq-group__head{color:var(--wine-soft)}\n  details{border-bottom:1px dashed var(--line);padding:14px 0}\n  .band--wine details,.band--deep details{border-color:rgba(247,242,232,.28)}\n  summary{cursor:pointer;font-weight:700;font-size:1rem;list-style:none;display:flex;gap:12px;align-items:flex-start}\n  summary::-webkit-details-marker{display:none}\n  summary::before{content:\"+\";font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;color:var(--accent);flex:0 0 auto;width:1em;line-height:1.6}\n  details[open] summary::before{content:\"–\"}\n  details p{margin:10px 0 0 1.9em;font-size:.94rem;color:var(--ink-soft)}\n  .band--wine details p,.band--deep details p{color:#e6d9c6}\n\n  footer{background:var(--wine-deep);color:#d9c9b6;padding:44px 0 52px;font-size:.88rem}\n  footer .wrap{display:grid;gap:18px}\n  @media(min-width:720px){\n    footer .wrap{grid-template-columns:1fr 1fr}\n  }\n  footer h2{font-size:1rem;color:var(--ivory);margin-bottom:8px}\n  footer p{margin:0 0 6px}\n  footer a{color:#f0d9a8}\n</style><main>\n\n  <section class=\"hero\">\n    <div class=\"hero-layer hero-layer--top\">\n      <div class=\"wrap\">\n        <p class=\"kicker\">Netsneak / 服务说明页</p>\n        <h1 id=\"brand-title\">netsneak</h1>\n      </div>\n    </div>\n\n    <div class=\"hero-layer hero-layer--mid\">\n      <div class=\"wrap\">\n        <div class=\"hero-grid\">\n          <div>\n            <p class=\"hero-sub\">这页不讲空话。netsneak 的套餐档位、客户端情况、上手顺序和常见疑问，按条目列在下面，便于你逐条核对后再决定。</p>\n          </div>\n          <ul class=\"fact-list\">\n            <li><span class=\"label\">品牌</span><span class=\"value\">netsneak</span></li>\n            <li><span class=\"label\">套餐档位</span><span class=\"value\">三档，按月或按年</span></li>\n            <li><span class=\"label\">客户端</span><span class=\"value\">官方暂未公布下载渠道</span></li>\n            <li><span class=\"label\">核实状态</span><span class=\"value\">待官方信息确认</span></li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"hero-layer hero-layer--low\">\n      <div class=\"wrap\">\n        <p class=\"kicker\">页内跳转</p>\n        <ul class=\"jump\">\n          <li><a href=\"#plans\">套餐档位</a></li>\n          <li><a href=\"#howto\">上手顺序</a></li>\n          <li><a href=\"#clients\">客户端情况</a></li>\n          <li><a href=\"#limits\">边界与限制</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band band--ivory\" id=\"plans\">\n    <div class=\"wrap\">\n      <h2 id=\"plans-title\">套餐档位：三档，阶梯往上升</h2>\n      <p class=\"band-lead\">三档的差别集中在三件事：每月流量额度、可同时在线设备数、以及权益范围。档位越高，配置越宽，价格也相应上移。按年付的价格为对应月费的十倍，相当于省下两个月。</p>\n\n      <div class=\"steps\">\n        <article class=\"ticket\">\n          <p class=\"ticket__no\">档位 01 / 基础版</p>\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<small>/月</small></p>\n          <p class=\"annual\">按年付 ¥150 / 年</p>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"ticket\">\n          <p class=\"ticket__no\">档位 02 / 旗舰版</p>\n          <span class=\"tag\">推荐档位</span>\n          <h3>旗舰版</h3>\n          <p class=\"price\">¥35<small>/月</small></p>\n          <p class=\"annual\">按年付 ¥350 / 年</p>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"ticket\">\n          <p class=\"ticket__no\">档位 03 / 团队版</p>\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<small>/月</small></p>\n          <p class=\"annual\">按年付 ¥850 / 年</p>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n\n      <p class=\"note\">价格与权益以上表为准。以上为待官方信息核实的档位设置，实际开通方式、支付渠道与是否支持中途改档，netsneak 暂未公布，请以官方渠道公告为准。本页不提供购买链接。</p>\n    </div>\n  </section>\n\n  <section class=\"band band--warm\" id=\"howto\">\n    <div class=\"wrap\">\n      <h2 id=\"howto-title\">上手顺序：四步，按顺序来</h2>\n      <p class=\"band-lead\">不熟悉的话，按下面的顺序推进，每一步都能独立验证，出问题时也好定位到是哪一环。</p>\n\n      <div class=\"cols cols--2\">\n        <ol class=\"steps-list\">\n          <li>\n            <h3>先确认档位</h3>\n            <p>对照上一节，用每月流量额度和设备数两个硬指标筛选。家里两三台设备日常用，基础版的 100GB 与 3 台在线通常够；多人共用或需要流媒体与线路优化，再看旗舰版。</p>\n          </li>\n          <li>\n            <h3>核对客户端来源</h3>\n            <p>在安装任何软件前，先确认它来自 netsneak 官方公布的位置。官方尚未公布客户端下载渠道时，不要从第三方站点获取安装包。</p>\n          </li>\n          <li>\n            <h3>导入并做一次连通验证</h3>\n            <p>配置导入后，先打开一个普通网页确认基础连通，再逐一测试需要用的服务。有问题时保留出现问题的具体步骤与时间点，方便后续排查。</p>\n          </li>\n          <li>\n            <h3>记录额度与设备占用</h3>\n            <p>每月初留意流量消耗节奏，避免月末吃紧；同时确认在线设备数没有超出档位上限，超出时新设备可能无法连接。</p>\n          </li>\n        </ol>\n\n        <div class=\"plain\">\n          <h3>准备清单</h3>\n          <p>开始之前，把这几样先备好：一台你要用的设备、稳定的本地网络、以及你打算使用的档位与设备数量。若涉及团队使用，还需要提前确定由谁管理账号与续费。</p>\n          <h3>容易踩的两处坑</h3>\n          <p>一是把「在线设备数」理解成「安装次数」——它是同时连接的数量，装得多不等于能同时连得多。二是把「流量额度」当成无限——超出档位额度后的处理方式，netsneak 目前没有公布，请勿按无限使用来规划。</p>\n          <h3>什么情况下先别急</h3>\n          <p>如果你需要的是明确的官方客户端、具体的节点列表或可验证的性能数据，那么现在还不是决定的时候。这些信息 netsneak 尚未公布，本页也不会替你补上。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band band--wine\" id=\"clients\">\n    <div class=\"wrap\">\n      <h2 id=\"clients-title\">客户端情况：暂未公布</h2>\n      <p class=\"band-lead\">这一节只说已知的部分，不列支持平台、不写版本号、不给下载地址。</p>\n\n      <div class=\"cols cols--3\">\n        <div class=\"plain\">\n          <h3>已确认</h3>\n          <p>netsneak 提供了三档订阅方案，档位之间在流量额度与设备数量上有明确区分。除此外，本页所依据的资料中没有更多可核实的技术细节。</p>\n        </div>\n        <div class=\"plain\">\n          <h3>未公布</h3>\n          <p>支持的平台与系统版本、客户端安装包的获取位置、配置导入方式、更新节奏，均未公布。因此本页不提供任何下载链接，也不承诺任何系统的兼容性。</p>\n        </div>\n        <div class=\"plain\">\n          <h3>你可以怎么做</h3>\n          <p>通过官方渠道确认客户端来源后再安装；在此之前，不要从第三方站点下载安装包，也不要向他人索取来路不明的配置文件。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band band--ivory\" id=\"limits\">\n    <div class=\"wrap\">\n      <h2 id=\"limits-title\">边界与限制：先把话说在前面</h2>\n      <div class=\"cols cols--3\">\n        <div class=\"plain\">\n          <h3>用量与设备</h3>\n          <p>每档都有月度流量额度和同时在线设备上限，两项独立计算。额度用尽或设备超限后的具体处理规则，需以官方说明为准。</p>\n        </div>\n        <div class=\"plain\">\n          <h3>线路差异</h3>\n          <p>不同档位对应的线路池不同：基础版为普通线路节点池，旗舰版涉及 IPLC 专线与流媒体解锁，团队版为 VIP 专属高带宽节点。实际可用范围受官方配置影响。</p>\n        </div>\n        <div class=\"plain\">\n          <h3>本页的定位</h3>\n          <p>本页是信息整理页，不是官方公告，不含购买、退款或试用承诺。凡是 facts 中没有的内容，这里一律留白，不做推测性描述。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band band--warm\" id=\"faq\">\n    <div class=\"wrap\">\n      <h2 id=\"faq-title\">常见问题</h2>\n      <p class=\"band-lead\">按主题分组。每条都给出答案；答案里没有的，就是目前确实没有可靠信息。</p>\n\n      <div class=\"faq-group\">\n        <p class=\"faq-group__head\">主题一 / 套餐与计费</p>\n        <details>\n          <summary>三档的主要区别是什么？</summary>\n          <p>看两个硬指标：每月流量额度与同时在线设备数。基础版为 100GB / 3 台，旗舰版为 300GB / 5 台，团队版为 1000GB / 20 台。权益随之递进：旗舰版增加全节点原生流媒体解锁、IPLC 专线游戏加速优化与优先工单支持；团队版增加 VIP 专属高带宽节点、企业定制路由与专属客户经理。</p>\n        </details>\n        <details>\n          <summary>按年付比按月付省多少？</summary>\n          <p>按年付为对应月费的十倍，即基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年，相当于按十二个月计算时省下两个月。</p>\n        </details>\n        <details>\n          <summary>能中途改档吗？</summary>\n          <p>本页无法确认。netsneak 尚未公布升级、降级或补差价的规则，请以官方渠道说明为准，不要按「随时可改」来规划档位。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <p class=\"faq-group__head\">主题二 / 客户端与安装</p>\n        <details>\n          <summary>从哪里下载 netsneak 客户端？</summary>\n          <p>目前没有可靠的官方下载地址可给出，因此本页不提供任何链接。请以 netsneak 官方公布的位置为准；在确认来源之前，不要从第三方站点获取安装包。</p>\n        </details>\n        <details>\n          <summary>支持哪些系统？</summary>\n          <p>未公布。品牌资料中没有平台与系统版本信息，本页不作兼容性承诺。需要按某个特定系统使用时，请先向官方确认。</p>\n        </details>\n        <details>\n          <summary>配置怎么导入？</summary>\n          <p>具体方式未公布。常规做法是使用官方下发的配置或订阅信息在客户端内导入，但 netsneak 的实际流程需以官方说明为准。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <p class=\"faq-group__head\">主题三 / 使用与用量</p>\n        <details>\n          <summary>「同时在线设备数」怎么算？</summary>\n          <p>指同一时间保持连接的设备数量上限，不是安装次数。基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限后新设备可能无法连接，具体表现以官方说明为准。</p>\n        </details>\n        <details>\n          <summary>流量超出当月额度会怎样？</summary>\n          <p>未公布。资料中没有关于超额后限速、暂停或计费加购的说明，本页不做推测。若用量接近上限，可考虑上移一档，或在下月初重新计算周期时再观察。</p>\n        </details>\n        <details>\n          <summary>游戏加速和流媒体解锁是三档都有吗？</summary>\n          <p>不是。基础版为普通线路节点池并解锁基础流媒体；全节点原生流媒体解锁与 IPLC 专线游戏加速优化从旗舰版起提供。团队版在此基础上提供 VIP 专属高带宽节点。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <p class=\"faq-group__head\">主题四 / 关于本页</p>\n        <details>\n          <summary>这页是 netsneak 官方发布的吗？</summary>\n          <p>不是。这是一份信息整理页，内容以现有资料为限，不含官方身份声明、性能数据、节点数量或用户评价。</p>\n        </details>\n        <details>\n          <summary>页面上的信息会变吗？</summary>\n          <p>价格与档位权益以官方渠道实际公布为准。若官方后续公布客户端、计费细则或其他技术说明，应以官方信息覆盖本页内容。</p>\n        </details>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div>\n      <h2>netsneak</h2>\n      <p>套餐、客户端与使用说明的整理页面。</p>\n      <p>不含购买链接、下载地址与退款承诺。</p>\n    </div>\n    <div>\n      <h2>页内入口</h2>\n      <p><a href=\"#plans\">套餐档位</a> ／ <a href=\"#howto\">上手顺序</a> ／ <a href=\"#clients\">客户端情况</a></p>\n      <p><a href=\"#limits\">边界与限制</a> ／ <a href=\"#faq\">常见问题</a></p>\n    </div>\n  </div>\n</footer>",
